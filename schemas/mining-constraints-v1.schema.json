{
  "$defs": {
    "AtomGrid": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "trend_close",
            "trend_pair",
            "vwap_context",
            "breakout_previous",
            "momentum",
            "candle_context",
            "volume",
            "volatility"
          ],
          "title": "Kind",
          "type": "string"
        },
        "grids": {
          "additionalProperties": {
            "$ref": "#/$defs/Grid"
          },
          "title": "Grids",
          "type": "object"
        },
        "direction_grids": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/Grid"
            },
            "type": "object"
          },
          "propertyNames": {
            "enum": [
              "BUY",
              "SELL"
            ]
          },
          "title": "Direction Grids",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "grids"
      ],
      "title": "AtomGrid",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "BUY",
        "SELL"
      ],
      "type": "string"
    },
    "GenerationPolicyV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "generation-policy/v1",
          "default": "generation-policy/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "candidate_budget": {
          "default": 10000,
          "maximum": 50000,
          "minimum": 1,
          "title": "Candidate Budget",
          "type": "integer"
        },
        "expansion_limit": {
          "default": 1000000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Expansion Limit",
          "type": "integer"
        },
        "max_conditions": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Conditions",
          "type": "integer"
        },
        "max_ast_depth": {
          "default": 2,
          "maximum": 2,
          "minimum": 1,
          "title": "Max Ast Depth",
          "type": "integer"
        },
        "max_features": {
          "default": 6,
          "maximum": 6,
          "minimum": 1,
          "title": "Max Features",
          "type": "integer"
        },
        "max_variable_dimensions": {
          "default": 12,
          "maximum": 12,
          "minimum": 1,
          "title": "Max Variable Dimensions",
          "type": "integer"
        },
        "max_cross_conditions": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Cross Conditions",
          "type": "integer"
        },
        "max_time_filters": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Max Time Filters",
          "type": "integer"
        },
        "max_grid_values": {
          "default": 32,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Grid Values",
          "type": "integer"
        },
        "max_templates": {
          "default": 32,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Templates",
          "type": "integer"
        },
        "min_period": {
          "default": 1,
          "maximum": 1000,
          "minimum": 1,
          "title": "Min Period",
          "type": "integer"
        },
        "max_period": {
          "default": 1000,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Period",
          "type": "integer"
        }
      },
      "title": "GenerationPolicyV1",
      "type": "object"
    },
    "Grid": {
      "items": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string"
          }
        ]
      },
      "type": "array"
    },
    "MiningSideConstraintsV1": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "template_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "title": "Template Ids",
          "type": "array"
        },
        "stops": {
          "items": {
            "type": "string"
          },
          "title": "Stops",
          "type": "array"
        },
        "targets": {
          "items": {
            "type": "string"
          },
          "title": "Targets",
          "type": "array"
        }
      },
      "required": [
        "enabled",
        "template_ids",
        "stops",
        "targets"
      ],
      "title": "MiningSideConstraintsV1",
      "type": "object"
    },
    "TemplateEntry": {
      "additionalProperties": false,
      "properties": {
        "template_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Template Id",
          "type": "string"
        },
        "base": {
          "$ref": "#/$defs/AtomGrid"
        },
        "confirmations": {
          "items": {
            "$ref": "#/$defs/AtomGrid"
          },
          "title": "Confirmations",
          "type": "array"
        }
      },
      "required": [
        "template_id",
        "base",
        "confirmations"
      ],
      "title": "TemplateEntry",
      "type": "object"
    },
    "TimeRangeV3": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "title": "Start",
          "type": "string"
        },
        "end": {
          "title": "End",
          "type": "string"
        },
        "start_inclusive": {
          "title": "Start Inclusive",
          "type": "boolean"
        },
        "end_inclusive": {
          "title": "End Inclusive",
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "end",
        "start_inclusive",
        "end_inclusive"
      ],
      "title": "TimeRangeV3",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "mining-constraints/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "logic": {
      "const": "AND_ONLY",
      "title": "Logic",
      "type": "string"
    },
    "sampling": {
      "const": "NONE",
      "title": "Sampling",
      "type": "string"
    },
    "truncation": {
      "const": "PROHIBITED",
      "title": "Truncation",
      "type": "string"
    },
    "template_catalog": {
      "items": {
        "$ref": "#/$defs/TemplateEntry"
      },
      "title": "Template Catalog",
      "type": "array"
    },
    "time_windows": {
      "items": {
        "$ref": "#/$defs/TimeRangeV3"
      },
      "title": "Time Windows",
      "type": "array"
    },
    "sides": {
      "additionalProperties": {
        "$ref": "#/$defs/MiningSideConstraintsV1"
      },
      "propertyNames": {
        "$ref": "#/$defs/Direction"
      },
      "title": "Sides",
      "type": "object"
    },
    "generation_policy": {
      "$ref": "#/$defs/GenerationPolicyV1"
    }
  },
  "required": [
    "schema_version",
    "logic",
    "sampling",
    "truncation",
    "template_catalog",
    "time_windows",
    "sides",
    "generation_policy"
  ],
  "title": "MiningConstraintsV1",
  "type": "object"
}
